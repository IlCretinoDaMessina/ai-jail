# =====================================================================
# config.env - ALL installation knobs, single source of truth (INS-06)
# WHY: changing TARGET_DRIVE or LINUX_USER must never require a code
# edit - bats read these values via `_common.bat :load`.
# Format: KEY=VALUE on one line; '#' starts a comment line (eol=#).
# Values must NEVER contain secrets (no passwords, no API keys).
# =====================================================================

# --- target machine ---------------------------------------------------
TARGET_DRIVE=D:
DISTRO=ai-jail
BASE_DISTRO=Ubuntu-24.04
LINUX_USER=aijail
# MIN_WSL_VERSION: `wsl --install <distro> --name --location` needs 2.4.4+
MIN_WSL_VERSION=2.4.4

# --- network allowlists (semicolon-separated tool hosts) --------------
# ALLOW_HOSTS_INSTALL example shape:
# ALLOW_HOSTS_INSTALL=crates.io;github.com;objects.githubusercontent.com
ALLOW_HOSTS_OPENCODE=registry.npmjs.org;github.com;objects.githubusercontent.com
ALLOW_HOSTS_COMFYUI=registry.npmjs.org;github.com;huggingface.co
ALLOW_HOSTS_INSTALL=crates.io;github.com;objects.githubusercontent.com

# --- disk / feature toggles ------------------------------------------
MIN_FREE_GB=20
INSTALL_COMFYUI=1
INSTALL_OPENCODE=1
INSTALL_VSCODE=0
# ENABLE_NONO: default OFF - optional Layer-3, never on by default (SBX-08)
ENABLE_NONO=0
